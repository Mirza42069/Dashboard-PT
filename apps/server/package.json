{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@DashboardV2/api": "workspace:*",
    "@DashboardV2/auth": "workspace:*",
    "@DashboardV2/db": "workspace:*",
    "@DashboardV2/env": "workspace:*",
    "@hono/trpc-server": "^0.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "catalog:",
    "@vercel/blob": "^2.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@DashboardV2/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:"
  }
}
