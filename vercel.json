{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && bun install --frozen-lockfile",
      "buildCommand": "bun ../../scripts/vercel-build-web.ts"
    },
    "server": {
      "root": "apps/server",
      "framework": "hono",
      "entrypoint": "server.mjs",
      "installCommand": "cd ../.. && bun install --frozen-lockfile",
      "buildCommand": "bun run --filter @DashboardV2/db db:migrate && bun run build && cp dist/index.mjs server.mjs",
      "routes": [
        {
          "src": "/api/((?!auth(?:/|$)).*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/internal/temporary-workbooks/cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}
