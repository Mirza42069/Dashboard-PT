# Local env files must never ship in deployments: Vercel project env vars are
# the source of truth (bun env:vercel:*), and frameworks like Next.js would
# otherwise load these localhost values at runtime.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
local.db
local.db-*
.alchemy/

# Local tooling and design references are not runtime inputs.
.agents/
.claude/
reference/

# Build outputs are recreated by each Vercel service build.
dist/
**/dist/
.next/
**/.next/
*.tsbuildinfo
**/*.tsbuildinfo
coverage/
