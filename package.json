{
  "name": "DashboardV2",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.13.0",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.26",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "@trpc/client": "^11.18.0",
      "@tailwindcss/postcss": "^4.3.2",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "tailwindcss": "^4.3.2"
    }
  },
  "type": "module",
  "scripts": {
    "predev": "bun scripts/free-ports.ts",
    "dev": "bun run --filter '*' dev",
    "dev:stop": "bun scripts/free-ports.ts",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "test": "bun test",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @DashboardV2/db db:push",
    "db:check": "bun run --filter @DashboardV2/db db:check",
    "db:studio": "bun run --filter @DashboardV2/db db:studio",
    "db:generate": "bun run --filter @DashboardV2/db db:generate",
    "db:migrate": "bun run --filter @DashboardV2/db db:migrate",
    "db:seed-admin": "bun --env-file=apps/server/.env scripts/seed-admin.ts",
    "db:seed-demo": "bun --env-file=apps/server/.env scripts/seed-demo.ts",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "bun scripts/sync-vercel-env.ts preview",
    "env:production": "bun scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "release:check": "bun run check-types && bun test && bun run db:check && bun run build && bun run deploy:check"
  },
  "dependencies": {
    "@DashboardV2/auth": "workspace:*",
    "@DashboardV2/db": "workspace:*",
    "@DashboardV2/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@DashboardV2/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "catalog:",
    "vercel": "^58.5.1"
  },
  "packageManager": "bun@1.3.6"
}
